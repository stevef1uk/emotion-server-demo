# Local Development Environment Configuration
# Copy this file to .env and fill in your values (never commit .env to git)

PORT=8080
GATEWAY_TOKEN_URL=https://preprod.agw.sjfisher.com/token
GATEWAY_MCP_URL=https://preprod.agw.sjfisher.com/mcp-emotion
TOKEN_TTL=900

# Set these from your Agent Gateway delegation (never hardcode in public repositories):
DELEGATION_ID=del-xxxxxxxxxxxxxxxxxxxxxxxx
AGENT_SECRET=your-agent-secret-here
